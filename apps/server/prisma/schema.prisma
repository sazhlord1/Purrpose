generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CommitmentStatus {
  ACTIVE
  COMPLETED
  FAILED
}

enum ConsequenceType {
  MEALS
  DRY_FOOD
  VET_CARE
}

enum TransactionType {
  STARTER_GRANT
  TOPUP
  FAILURE_DEDUCTION
}

enum UserRole {
  USER
  ADMIN
}

/// PURR ledger movements. `amount` is always > 0; direction comes from the type.
enum PurrTxnType {
  PURCHASE // bought with real money through a payment provider (+)
  SANDBOX_PURCHASE // test-mode purchase, PAYMENTS_MODE=sandbox only (+)
  ADMIN_GRANT // granted by an admin (+)
  SPEND // spent in the shop, e.g. unlocking a cat (-)
}

/// Detective Cheat habit pacts.
enum HabitStatus {
  ACTIVE
  KEPT // survived the period (the locked share still went to the cats)
  BROKEN // hit the slip limit: the whole stake went to the cats
}

enum NotificationKind {
  T24H
  T1H
  FAILED
}

model User {
  id            String              @id @default(cuid())
  name          String?
  /// What we greet the user with ("Good morning, Setareh").
  firstName     String?
  lastName      String?
  /// Lower-cased. Null for anonymous (guest) users.
  email         String?             @unique
  /// scrypt hash — never the raw password.
  passwordHash  String?
  /// Google account id (`sub` of the ID token). Null until the user signs in with Google.
  googleId      String?             @unique
  /// Set when we know the user controls the email (e.g. Google said it's verified).
  emailVerifiedAt DateTime?
  role          UserRole            @default(USER)
  purrBalance   Int                 @default(0)
  /// Equipped shop items, one per slot, e.g. {"toy":"ball"}. Validated on read.
  loadout       Json                @default("{}")
  lastLoginAt   DateTime?
  createdAt     DateTime            @default(now())
  balances      CreditBalance[]
  commitments   Commitment[]
  transactions  CreditTransaction[]
  sessions      Session[]
  purrTxns      PurrTransaction[]
  catUnlocks    CatUnlock[]
  itemUnlocks   ItemUnlock[]
  focusSessions FocusSession[]
  pushSubs      PushSubscription[]
  habits        Habit[]
}

model Session {
  /// SHA-256 (hex) of the bearer token. The raw token only ever lives on the client.
  tokenHash String    @id @map("token")
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  /// Null = guest session that never expires. Logged-in sessions expire.
  expiresAt DateTime?

  @@index([userId])
}

model Commitment {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id])
  title             String
  description       String?
  deadline          DateTime
  status            CommitmentStatus    @default(ACTIVE)
  catId             String
  consequenceType   ConsequenceType
  consequenceAmount Int
  createdAt         DateTime            @default(now())
  completedAt       DateTime?
  failedAt          DateTime?
  transactions      CreditTransaction[]
  focusSessions     FocusSession[]
  notifications     NotificationLog[]

  @@index([userId, status])
  @@index([status, deadline])
}

model CreditBalance {
  userId     String
  creditType ConsequenceType
  amount     Int
  user       User            @relation(fields: [userId], references: [id])

  @@id([userId, creditType])
}

model CreditTransaction {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id])
  type         TransactionType
  creditType   ConsequenceType
  amount       Int
  commitmentId String?
  commitment   Commitment?     @relation(fields: [commitmentId], references: [id])
  habitId      String?
  habit        Habit?          @relation(fields: [habitId], references: [id])
  createdAt    DateTime        @default(now())

  @@index([userId, createdAt])
}

model PurrTransaction {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  type      PurrTxnType
  amount    Int
  /// What was bought, e.g. "cat:mochi" or "pack:purr_300".
  itemId    String?
  /// External payment reference. Unique so a provider webhook can never credit twice.
  reference String?     @unique
  createdAt DateTime    @default(now())

  @@index([userId, createdAt])
}

model CatUnlock {
  userId    String
  catId     String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@id([userId, catId])
}

model ItemUnlock {
  userId    String
  itemId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@id([userId, itemId])
}

model FocusSession {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  commitmentId String?
  commitment   Commitment? @relation(fields: [commitmentId], references: [id], onDelete: SetNull)
  catId        String
  durationSec  Int
  startedAt    DateTime
  endedAt      DateTime
  createdAt    DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([commitmentId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  /// Language of the device ('en' | 'fa'); notifications are written in it.
  locale    String   @default("en")
  createdAt DateTime @default(now())

  @@index([userId])
}

/// One row per (commitment, kind) — guarantees each push is sent at most once.
model NotificationLog {
  commitmentId String
  kind         NotificationKind
  commitment   Commitment       @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  sentAt       DateTime         @default(now())

  @@id([commitmentId, kind])
}

model AppEvent {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  payload   Json?
  createdAt DateTime @default(now())
}

/// A habit pact (Detective Cheat): stake food, confess slips, each slip locks stake ÷ maxSlips.
model Habit {
  id              String              @id @default(cuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id])
  title           String
  catId           String
  consequenceType ConsequenceType
  stakeAmount     Int
  maxSlips        Int
  slipCount       Int                 @default(0)
  status          HabitStatus         @default(ACTIVE)
  startedAt       DateTime            @default(now())
  endsAt          DateTime
  settledAt       DateTime?
  /// Credits the cats got when it settled.
  lostAmount      Int?
  createdAt       DateTime            @default(now())
  slips           HabitSlip[]
  transactions    CreditTransaction[]

  @@index([userId, status])
  @@index([status, endsAt])
}

model HabitSlip {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([habitId])
}
