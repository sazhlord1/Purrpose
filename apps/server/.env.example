DATABASE_URL="postgresql://purrpose:purrpose@localhost:5433/purrpose?schema=public"
PORT=3000
HOST=127.0.0.1
# development enables /api/v1/dev/* (time travel, reset). Production MUST use "production".
NODE_ENV=development

# Production only: the web app's origin(s), comma-separated.
# WEB_ORIGIN=https://your-app.vercel.app

# Admin account — created/updated on server start. Never commit real values.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=change-me-to-something-long

# PURR purchases: disabled | sandbox (free test credits — never in production) | live
PAYMENTS_MODE=sandbox

# Web push. Generate with: pnpm --filter @purrpose/server vapid:generate
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
