{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "useDefineForClassFields": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@purrpose/shared": ["../../packages/shared/src/index.ts"],
      "@purrpose/cats": ["../../packages/cats/src/index.ts"]
    }
  },
  "include": ["src"]
}
